{
  "name": "@home-agent/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --env-file=../../.env --bun vite preview",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --max-warnings 0 --fix .",
    "check-types": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@home-agent/api": "workspace:*",
    "@home-agent/backend": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-core": "^5.103.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "eventsource-parser": "4.1.1",
    "hono": "catalog:",
    "jotai": "^3.0.0",
    "jotai-tanstack-query": "^0.11.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.3",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.88.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "@home-agent/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:",
    "@home-agent/oxlint-config": "workspace:*"
  }
}
