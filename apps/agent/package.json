{
  "name": "@home-agent/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "prompts:init": "bun --env-file=../../.env scripts/initialize-prompts.ts",
    "context:format": "bun scripts/format-context.ts",
    "lint": "bun run generate && oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "bun run generate && oxlint --type-aware --max-warnings 0 --fix .",
    "check-types": "bun run generate && tsc --noEmit",
    "generate": "bun scripts/codegen/index.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-durable": "catalog:",
    "@home-agent/api": "workspace:*",
    "@home-agent/observability": "workspace:*",
    "@langfuse/client": "6.0.1",
    "es-toolkit": "^1.52.0",
    "hono": "catalog:",
    "typebox": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@home-agent/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "@home-agent/oxlint-config": "workspace:*",
    "oxfmt": "catalog:"
  },
  "exports": {
    "./workflows": "./src/workflows/contracts.generated.ts",
    "./workflows/automation-generation": "./src/workflows/automation-generation/workflow.ts",
    "./workflows/spatial-planning": "./src/workflows/spatial-planning/workflow.ts",
    "./workflows/speech-interpretation": "./src/workflows/speech-interpretation/workflow.ts",
    "./assistant": "./src/assistant/assistant.ts",
    "./assistant/contracts": "./src/assistant/contracts.ts",
    "./config": "./src/config.ts",
    "./models": "./src/models.ts",
    "./perception": "./src/perception/analysis.ts",
    "./runtime": "./src/runtime.ts",
    "./routes": "./src/routes/index.ts",
    "./workflows/runtime": "./src/workflows/index.ts",
    "./context/receiver": "./src/context/receiver.ts",
    "./context/reader": "./src/context/reader.ts",
    "./context/source": "./src/context/source.ts",
    "./context/contracts": "./src/context/contracts.ts",
    "./context/devices": "./src/context/devices.ts",
    "./context/model-view": "./src/context/model-view/index.ts",
    "./context/model-view/format": "./src/context/model-view/format.ts",
    "./context/model-view/decoding": "./src/context/model-view/decoding.ts",
    "./development": "./scripts/watch.ts",
    "./conversation/contracts": "./src/conversation/contracts.ts"
  }
}
