{
  "name": "@home-agent/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch scripts/dev.ts",
    "build": "bun run check-types && bun build src/main.ts --target=bun --packages=external --outdir=dist --sourcemap=external",
    "start": "bun --env-file=../../.env dist/main.js",
    "context:format": "bun scripts/format-context.ts",
    "lint": "bun run generate && oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "bun run generate && oxlint --type-aware --max-warnings 0 --fix .",
    "check-types": "bun run generate && tsc --noEmit",
    "generate": "bun scripts/codegen/index.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-durable": "catalog:",
    "@home-agent/api": "workspace:*",
    "@home-agent/backend-client": "workspace:*",
    "@home-agent/observability": "workspace:*",
    "hono": "catalog:",
    "radash": "12.1.1",
    "typebox": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@home-agent/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "@home-agent/oxlint-config": "workspace:*",
    "oxfmt": "catalog:"
  }
}
