{
  "name": "@home-agent/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist --sourcemap=external",
    "start": "bun --env-file=../../.env dist/main.js",
    "context:format": "bun src/context/model-view/cli.ts",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --max-warnings 0 --fix .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "catalog:",
    "zod": "catalog:",
    "@home-agent/api": "workspace:*",
    "deepagents": "1.14.2",
    "langchain": "1.5.15",
    "@home-agent/model": "workspace:*",
    "langsmith": "catalog:"
  },
  "devDependencies": {
    "@home-agent/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "@home-agent/oxlint-config": "workspace:*"
  }
}
