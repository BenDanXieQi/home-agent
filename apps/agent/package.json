{
  "name": "@home-agent/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist --sourcemap=external",
    "start": "bun --env-file=../../.env dist/main.js",
    "context:format": "bun scripts/format-context.ts",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --max-warnings 0 --fix .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:",
    "@home-agent/api": "workspace:*",
    "@home-agent/observability": "workspace:*",
    "@home-agent/backend-client": "workspace:*",
    "hono": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@home-agent/configuration": "workspace:*",
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-durable": "catalog:"
  },
  "devDependencies": {
    "@home-agent/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "@home-agent/oxlint-config": "workspace:*"
  }
}
