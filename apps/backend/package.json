{
  "name": "@home-agent/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "ORT_DISABLE_TELEMETRY=1 bun --env-file=../../.env --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist --sourcemap=external && bun run build:perception && bun scripts/copy-web.ts",
    "start": "ORT_DISABLE_TELEMETRY=1 bun --env-file=../../.env dist/main.js",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --max-warnings 0 --fix .",
    "check-types": "tsc --noEmit",
    "test": "bun test ./tests",
    "db:generate": "bun --env-file=../../.env --bun run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env --bun run drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env --bun run drizzle-kit studio",
    "db:check": "bun --env-file=../../.env scripts/db-check.ts",
    "build:rpc": "tsc --project tsconfig.rpc.json",
    "dev:rpc": "tsc --project tsconfig.rpc.json --watch --preserveWatchOutput",
    "detect:image": "ORT_DISABLE_TELEMETRY=1 bun scripts/detect-image.ts",
    "benchmark:perception": "ORT_DISABLE_TELEMETRY=1 bun scripts/benchmark-detection.ts",
    "evaluate:pets": "ORT_DISABLE_TELEMETRY=1 bun scripts/evaluate-pet-tracking.ts",
    "evaluate:models": "ORT_DISABLE_TELEMETRY=1 bun scripts/compare-indoor-models.ts",
    "build:perception": "test -f models/det_4C.onnx && test -f models/human_body_reid_v2.onnx && test -f models/LICENSE.md && bun build src/perception/compute/process-entry.ts src/perception/compute/inference-worker.ts --target=bun --packages=external --outdir=dist/perception/compute --sourcemap=external && bun build src/perception/tracking/reid-entry.ts --target=bun --packages=external --outdir=dist/perception/tracking --sourcemap=external && bun build scripts/detect-image.ts --target=bun --packages=external --outdir=dist --sourcemap=external"
  },
  "dependencies": {
    "@home-agent/api": "workspace:*",
    "@home-agent/observability": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "mqtt": "5.16.0",
    "onnxruntime-node": "1.30.0",
    "p-timeout": "7.0.1",
    "piscina": "5.3.2",
    "postgres": "catalog:",
    "sharp": "0.35.5",
    "tough-cookie": "6.0.2",
    "write-file-atomic": "catalog:",
    "xstate": "5.33.2",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@home-agent/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/write-file-atomic": "catalog:",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "@home-agent/oxlint-config": "workspace:*"
  },
  "exports": {
    "./client": {
      "types": "./dist/rpc/client.d.ts",
      "default": "./src/client.ts"
    }
  }
}
