# 数据库：两处密码须一致。
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://home_agent:change-me@127.0.0.1:5432/home_agent

# 模型与原生凭据：apps/agent/README.md
AGENT_MODEL=
OPENAI_API_KEY=
# AGENT_MODEL=openai/gpt-4o-mini
# AGENT_AUTOMATION_MODEL=deepseek/deepseek-chat
# AGENT_SPEECH_MODEL=
# AGENT_SPATIAL_MODEL=
# AGENT_SUBAGENT_MODELS='["anthropic/claude-sonnet-4-5","openai/gpt-4o-mini"]'
# AGENT_SHUTDOWN_TIMEOUT_MS=10000

# 可选本地 Langfuse：docs/running.md；启用时填 langfuse 和以下凭据。
COMPOSE_PROFILES=
LANGFUSE_LOCAL_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Agent 提示词管理：docs/agent/prompt-management.md；所有受管提示词统一使用以下版本标签。
# AGENT_PROMPT_LABEL=production
# LANGFUSE_TRACING_ENABLED=false  # 单独关闭 Langfuse，保留通用 OTel 导出。
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# 可选通用 OTel Collector：可与 Langfuse 同时接收追踪。
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
