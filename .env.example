# 数据库：密码、宿主端口须与 DATABASE_URL 一致。
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://home_agent:change-me@127.0.0.1:5432/home_agent

# 两个主 Agent 的 MySQL；密码和端口须与 AGENT_DATABASE_URL 一致。
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PORT=3306
AGENT_DATABASE_URL=mysql://home_agent:change-me@127.0.0.1:3306/home_agent?sslmode=require

# 模型填写 provider/modelId，凭据只需填写所选提供商：apps/agent/README.md。
AGENT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XIAOMI_TOKEN_PLAN_CN_API_KEY=
# 音视频分析需同时配置 AGENT_MODEL（媒体主会话）和以下子分析模型。
AGENT_MEDIA_ANALYSIS_MODEL=

# llama.cpp：模型填写 llamacpp/<服务返回的模型 ID>，地址包含 /v1。
LLAMA_CPP_BASE_URL=
LLAMA_CPP_API_KEY=

# Langfuse：docs/running.md；本地启用时 COMPOSE_PROFILES 填 langfuse。
COMPOSE_PROFILES=langfuse
LANGFUSE_PORT=51972
LANGFUSE_LOCAL_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
OTEL_INCLUDE_CONTENT=false
LANGFUSE_LLM_CONNECTION_ALLOWED_HOSTS=
