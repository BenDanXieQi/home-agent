# Loaded from the repository root by each app's scripts.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
# Agent/go2rtc connection URLs are managed in config/config.yaml (auto-created).
BACKEND_REQUEST_TIMEOUT_MS=130000
BACKEND_SHUTDOWN_TIMEOUT_MS=30000

# Local Docker database. Replace both matching passwords before starting it.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://home_agent:change-me@127.0.0.1:5432/home_agent

AGENT_HOST=127.0.0.1
AGENT_PORT=1811
AGENT_MODEL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-provider.example/v1
AGENT_RUN_TIMEOUT_MS=120000
# Optional separate Agent DB credentials; defaults to DATABASE_URL.
# AGENT_DATABASE_URL=postgres://user:password@127.0.0.1:5432/home_agent

# Shared by backend and Agent: none (off), console (local), otlp (export).
OTEL_TRACES_EXPORTER=none
# Model inputs/outputs and detailed errors are omitted unless explicitly enabled.
OTEL_INCLUDE_CONTENT=false

# With otlp and no custom OTLP endpoint, export directly to LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=home-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required for organization-scoped API keys:
# LANGSMITH_WORKSPACE_ID=

# Optional collector instead of direct LangSmith export. No LangSmith key is sent
# to a custom collector. Configure the collector's LangSmith exporter separately.
# This is the full traces URL; OTLP/HTTP protobuf is used.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20your-token
# Alternatively use a base URL (the exporter appends /v1/traces):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
