# Loaded from the repository root by each app's scripts.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
# Agent/go2rtc connection URLs are managed in config/config.yaml (auto-created).
BACKEND_REQUEST_TIMEOUT_MS=130000
BACKEND_SHUTDOWN_TIMEOUT_MS=30000

# Local Docker database. Replace both matching passwords before starting it.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://home_agent:change-me@127.0.0.1:5432/home_agent

AGENT_HOST=127.0.0.1
AGENT_PORT=1811
# Shared model configuration for the assistant and backend interpreters.
# Native pi-ai provider ID. OpenAI uses the Responses API.
AGENT_PROVIDER=openai
AGENT_MODEL=
# MiMo token plan: AGENT_PROVIDER=xiaomi-token-plan-cn
# Unknown models require explicit JSON capabilities; see packages/configuration/README.md.
# AGENT_MODEL_METADATA={...}
# For providers supporting thinking.type (such as MiMo); omit otherwise.
# AGENT_THINKING=disabled
OPENAI_API_KEY=
# Override only for a verified endpoint of this provider, or a custom model.
# OPENAI_BASE_URL=https://your-provider.example/v1
AGENT_RUN_TIMEOUT_MS=120000
AGENT_MAX_OUTPUT_TOKENS=4096

# Shared backend and Agent tracing: none (off), console (local), otlp (export).
OTEL_TRACES_EXPORTER=none
# Model inputs/outputs and detailed errors are omitted unless explicitly enabled.
OTEL_INCLUDE_CONTENT=false

# With otlp and no custom OTLP endpoint, export directly to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional collector instead of direct Langfuse export. No Langfuse key is sent
# to a custom collector. Configure the collector's Langfuse exporter separately.
# This is the full traces URL; OTLP/HTTP protobuf is used.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20your-token
# Alternatively use a base URL (the exporter appends /v1/traces):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Optional path to a persistent 0600 credential key file (default: config/credentials.key).
# CREDENTIAL_KEY_FILE=/run/secrets/home-agent-credentials

# FFmpeg runs alongside the backend compute process, not inside go2rtc.
PERCEPTION_FFMPEG_PATH=ffmpeg
