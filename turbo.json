{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@home-agent/backend#build": {
      "dependsOn": ["^build", "@home-agent/web#build"],
      "outputs": ["dist/main.js", "dist/main.js.map", "dist/public/**"]
    },
    "@home-agent/web#build": {
      "dependsOn": ["^build:rpc", "check-types"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "//#lint:root": {
      "dependsOn": ["@home-agent/oxlint-config#lint"],
      "inputs": [
        "scripts/**",
        "oxlint.config.ts",
        "package.json",
        "turbo.json"
      ],
      "outputs": []
    },
    "//#lint:root:fix": {
      "cache": false
    },
    "//#check-types:root": {
      "dependsOn": ["@home-agent/oxlint-config#check-types"],
      "inputs": ["scripts/**", "oxlint.config.ts", "package.json"],
      "outputs": []
    },
    "build:rpc": {
      "dependsOn": ["^check-types"],
      "outputs": ["dist/rpc/**"]
    },
    "dev:rpc": {
      "cache": false,
      "persistent": true
    },
    "@home-agent/web#check-types": {
      "dependsOn": ["^check-types", "^build:rpc"]
    },
    "@home-agent/web#lint": {
      "dependsOn": ["^lint", "^build:rpc"]
    },
    "@home-agent/web#dev": {
      "dependsOn": ["^build:rpc"],
      "with": ["@home-agent/backend#dev:rpc"],
      "cache": false,
      "persistent": true
    },
    "@home-agent/web#lint:fix": {
      "dependsOn": ["^build:rpc"],
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "AGENT_HOST",
    "AGENT_PORT",
    "AGENT_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "LANGSMITH_API_KEY",
    "LANGSMITH_PROJECT",
    "LANGSMITH_ENDPOINT",
    "LANGSMITH_TRACING",
    "LANGSMITH_TRACING_V2",
    "LANGCHAIN_TRACING_V2",
    "LANGCHAIN_TRACING",
    "AGENT_RUN_TIMEOUT_MS",
    "BACKEND_HOST",
    "BACKEND_PORT",
    "BACKEND_REQUEST_TIMEOUT_MS",
    "BACKEND_SHUTDOWN_TIMEOUT_MS",
    "LANGSMITH_WORKSPACE_ID",
    "OTEL_TRACES_EXPORTER",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_EXPORTER_OTLP_TRACES_HEADERS",
    "OTEL_INCLUDE_CONTENT",
    "DATABASE_URL",
    "CREDENTIAL_KEY_FILE",
    "AGENT_DATABASE_URL"
  ],
  "globalEnv": ["NODE_ENV"]
}
