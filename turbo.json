{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "@home-agent/backend#build": {
      "dependsOn": ["^build", "@home-agent/web#build"],
      "outputs": [
        "dist/main.js",
        "dist/main.js.map",
        "dist/public/**",
        "dist/perception/**",
        "dist/detect-image.js",
        "dist/detect-image.js.map"
      ]
    },
    "@home-agent/web#build": {
      "dependsOn": ["check-types"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "//#lint:root": {
      "dependsOn": ["@home-agent/oxlint-config#lint"],
      "inputs": [
        "scripts/**",
        "oxlint.config.ts",
        "package.json",
        "turbo.json"
      ],
      "outputs": []
    },
    "//#lint:root:fix": {
      "cache": false
    },
    "//#check-types:root": {
      "dependsOn": ["@home-agent/oxlint-config#check-types"],
      "inputs": ["scripts/**", "oxlint.config.ts", "package.json"],
      "outputs": []
    },
    "build:rpc": {
      "dependsOn": ["^check-types"],
      "outputs": ["dist/rpc/**"]
    },
    "dev:rpc": {
      "cache": false,
      "persistent": true
    },
    "@home-agent/web#check-types": {
      "dependsOn": ["^check-types", "@home-agent/backend-client#build"]
    },
    "@home-agent/web#lint": {
      "dependsOn": ["^lint", "@home-agent/backend-client#build"]
    },
    "@home-agent/web#dev": {
      "dependsOn": ["@home-agent/backend-client#build"],
      "with": [
        "@home-agent/backend#dev:rpc",
        "@home-agent/backend-client#dev:types",
        "@home-agent/backend-client#dev:runtime"
      ],
      "cache": false,
      "persistent": true
    },
    "@home-agent/web#lint:fix": {
      "dependsOn": ["@home-agent/backend-client#build"],
      "cache": false
    },
    "@home-agent/backend#test": {
      "cache": false,
      "passThroughEnv": [
        "PERCEPTION_INDOOR_DATA_DIR",
        "PERCEPTION_TUD_VIDEO_PATH",
        "PERCEPTION_TUD_LABELS_PATH",
        "ORT_DISABLE_TELEMETRY"
      ]
    },
    "@home-agent/backend-client#check-types": {
      "dependsOn": ["@home-agent/backend#build:rpc"]
    },
    "@home-agent/backend-client#lint": {
      "dependsOn": ["@home-agent/backend#build:rpc"]
    },
    "@home-agent/backend-client#lint:fix": {
      "dependsOn": ["@home-agent/backend#build:rpc"],
      "cache": false
    },
    "@home-agent/agent#build": {
      "dependsOn": ["check-types"],
      "outputs": []
    },
    "@home-agent/agent#check-types": {
      "dependsOn": ["^check-types"]
    },
    "@home-agent/agent#lint": {
      "dependsOn": ["^lint"]
    },
    "@home-agent/agent#lint:fix": {
      "cache": false
    },
    "@home-agent/backend-client#build": {
      "dependsOn": ["@home-agent/backend#build:rpc"],
      "outputs": ["dist/**"]
    },
    "@home-agent/backend-client#dev:types": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@home-agent/agent-host#start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "*_API_KEY",
        "ANTHROPIC_*",
        "AWS_*",
        "GOOGLE_*",
        "GCLOUD_*",
        "CLOUDSDK_*",
        "CLOUDFLARE_*",
        "AZURE_*",
        "OPENAI_*",
        "COPILOT_*",
        "GITHUB_TOKEN"
      ]
    },
    "@home-agent/agent-host#dev": {
      "passThroughEnv": [
        "*_API_KEY",
        "ANTHROPIC_*",
        "AWS_*",
        "GOOGLE_*",
        "GCLOUD_*",
        "CLOUDSDK_*",
        "CLOUDFLARE_*",
        "AZURE_*",
        "OPENAI_*",
        "COPILOT_*",
        "GITHUB_TOKEN"
      ],
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "@home-agent/agent#build",
        "@home-agent/backend-client#build"
      ],
      "with": [
        "@home-agent/backend#dev:rpc",
        "@home-agent/backend-client#dev:types",
        "@home-agent/backend-client#dev:runtime"
      ]
    },
    "@home-agent/agent-host#check-types": {
      "dependsOn": ["^check-types", "@home-agent/backend-client#build"]
    },
    "@home-agent/agent-host#lint": {
      "dependsOn": ["^lint", "@home-agent/backend-client#build"]
    },
    "@home-agent/agent-host#lint:fix": {
      "dependsOn": ["@home-agent/backend-client#build"],
      "cache": false
    },
    "@home-agent/backend-client#dev:runtime": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "AGENT_HOST",
    "AGENT_PORT",
    "AGENT_MODEL",
    "AGENT_AUTOMATION_MODEL",
    "AGENT_SPEECH_MODEL",
    "AGENT_SPATIAL_MODEL",
    "AGENT_SUBAGENT_MODELS",
    "*_API_KEY",
    "ANTHROPIC_OAUTH_TOKEN",
    "COMPOSE_PROFILES",
    "LANGFUSE_PORT",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "LANGFUSE_BASE_URL",
    "LANGFUSE_TRACING_ENABLED",
    "AGENT_CONTEXT_BYTES",
    "PERCEPTION_FFMPEG_PATH",
    "BACKEND_HOST",
    "BACKEND_PORT",
    "BACKEND_URL",
    "BACKEND_REQUEST_TIMEOUT_MS",
    "BACKEND_SHUTDOWN_TIMEOUT_MS",
    "OTEL_TRACES_EXPORTER",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_EXPORTER_OTLP_TRACES_HEADERS",
    "OTEL_INCLUDE_CONTENT",
    "DATABASE_URL",
    "CREDENTIAL_KEY_FILE",
    "AGENT_DATABASE_URL"
  ],
  "globalEnv": ["NODE_ENV"]
}
