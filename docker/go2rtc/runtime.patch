 	}
 	return json.Marshal(info)
 }
+
+// Close releases a private stream whose owner has stopped accepting consumers.
+// Callers must serialize this against their AddConsumer operations.
+func (s *Stream) Close() {
+	s.mu.Lock()
+	consumers := append([]core.Consumer(nil), s.consumers...)
+	s.consumers = nil
+	producers := append([]*Producer(nil), s.producers...)
+	s.mu.Unlock()
+	for _, consumer := range consumers {
+		_ = consumer.Stop()
+	}
+	for _, producer := range producers {
+		producer.stop()
+	}
+}
