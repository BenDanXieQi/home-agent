diff --git a/web/src/features/playground/page/hooks/usePlaygroundVideoUpload.ts b/web/src/features/playground/page/hooks/usePlaygroundVideoUpload.ts
new file mode 100644
index 0000000..4c02e23
--- /dev/null
+++ b/web/src/features/playground/page/hooks/usePlaygroundVideoUpload.ts
@@ -0,0 +1,105 @@
+import { Sha256 } from "@aws-crypto/sha256-browser";
+import { useCallback, useRef, useState } from "react";
+import { type EditorView } from "@uiw/react-codemirror";
+
+import useProjectIdFromURL from "@/src/hooks/useProjectIdFromURL";
+import { api } from "@/src/utils/api";
+import { MediaContentType } from "@/src/features/media";
+import { useOptionalPlaygroundContext } from "@/src/features/playground/page/context/PlaygroundProvider";
+
+export function usePlaygroundVideoUpload() {
+  const projectId = useProjectIdFromURL();
+  const beginMediaUpload = useOptionalPlaygroundContext()?.beginMediaUpload;
+  const { mutateAsync: getUploadUrl } =
+    api.media.getPlaygroundUploadUrl.useMutation();
+  const { mutateAsync: markUploadComplete } =
+    api.media.markPlaygroundUploadComplete.useMutation();
+  const busy = useRef(false);
+  const [isUploading, setIsUploading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const uploadFiles = useCallback(
+    async (files: File[], view: EditorView, anchor?: number) => {
+      if (
+        busy.current ||
+        !projectId ||
+        !beginMediaUpload ||
+        !view.dom.isConnected
+      )
+        return;
+      busy.current = true;
+      const finishMediaUpload = beginMediaUpload();
+      setIsUploading(true);
+      setError(null);
+
+      let position = anchor ?? view.state.selection.main.from;
+      try {
+        for (const file of files) {
+          if (
+            file.type !== "video/mp4" &&
+            !(file.type === "" && /\.mp4$/i.test(file.name))
+          ) {
+            throw new Error("请选择 MP4 视频。");
+          }
+          if (file.size === 0 || file.size > 100 * 1024 * 1024) {
+            throw new Error("视频不能为空，且不能超过 100 MiB。");
+          }
+
+          const hash = new Sha256();
+          hash.update(new Uint8Array(await file.arrayBuffer()));
+          const digest = await hash.digest();
+          const sha256Hash = btoa(String.fromCharCode(...digest));
+          const { mediaId, uploadUrl, uploadHeaders } = await getUploadUrl({
+            projectId,
+            contentType: MediaContentType.MP4,
+            contentLength: file.size,
+            sha256Hash,
+          });
+
+          if (uploadUrl) {
+            const startedAt = Date.now();
+            const response = await fetch(uploadUrl, {
+              method: "PUT",
+              headers: { "Content-Type": "video/mp4", ...uploadHeaders },
+              body: file,
+              signal: AbortSignal.timeout(120_000),
+            });
+            await markUploadComplete({
+              projectId,
+              mediaId,
+              uploadedAt: new Date(),
+              uploadHttpStatus: response.status,
+              uploadTimeMs: Date.now() - startedAt,
+            });
+            if (!response.ok) {
+              throw new Error(
+                `视频上传失败（HTTP ${response.status}），请重试。`,
+              );
+            }
+          }
+
+          if (!view.dom.isConnected) return;
+          position = Math.min(position, view.state.doc.length);
+          const reference = `@@@langfuseMedia:type=video/mp4|id=${mediaId}|source=bytes@@@`;
+          const insert = `\n${reference}\n`;
+          view.dispatch({
+            changes: { from: position, insert },
+            selection: { anchor: position + insert.length },
+          });
+          position += insert.length;
+        }
+      } catch (cause) {
+        setError(
+          cause instanceof Error ? cause.message : "视频导入失败，请重试。",
+        );
+      } finally {
+        busy.current = false;
+        setIsUploading(false);
+        finishMediaUpload();
+      }
+    },
+    [projectId, beginMediaUpload, getUploadUrl, markUploadComplete],
+  );
+
+  return { uploadFiles, isUploading, error };
+}
diff --git a/web/src/pages/api/internal/playground-media/cleanup.ts b/web/src/pages/api/internal/playground-media/cleanup.ts
new file mode 100644
index 0000000..eefd900
--- /dev/null
+++ b/web/src/pages/api/internal/playground-media/cleanup.ts
@@ -0,0 +1,20 @@
+import { z } from "zod";
+
+import { deleteUnassociatedVideos } from "@/src/features/media/server";
+import { createAuthedProjectAPIRoute } from "@/src/features/public-api/server/createAuthedProjectAPIRoute";
+import { withMiddlewares } from "@/src/features/public-api/server/withMiddlewares";
+import { ForbiddenError } from "@langfuse/shared";
+
+export default withMiddlewares({
+  POST: createAuthedProjectAPIRoute({
+    name: "Clean up unused Playground videos",
+    action: "media:create",
+    bodySchema: z.object({ retentionDays: z.number().int().min(3) }),
+    responseSchema: z.object({ deleted: z.number(), hasMore: z.boolean() }),
+    fn: async ({ body, auth }) => {
+      if (auth.scope.accessLevel !== "project") throw new ForbiddenError();
+
+      return deleteUnassociatedVideos(auth.scope.projectId, body.retentionDays);
+    },
+  }),
+});
