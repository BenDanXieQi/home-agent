+
+/** Reclaims expired uploads that have never acquired a saved reference. */
+export async function deleteUnassociatedVideos(
+  projectId: string,
+  retentionDays: number,
+) {
+  const cutoff = new Date(Date.now() - retentionDays * 86_400_000);
+  const expiredAndUnassociated = Prisma.sql`
+    m.project_id = ${projectId}
+    AND m.content_type = 'video/mp4'
+    AND m.updated_at < ${cutoff}
+    AND NOT EXISTS (
+      SELECT 1 FROM trace_media t
+      WHERE t.project_id = m.project_id AND t.media_id = m.id
+    )
+    AND NOT EXISTS (
+      SELECT 1 FROM observation_media o
+      WHERE o.project_id = m.project_id AND o.media_id = m.id
+    )
+    AND NOT EXISTS (
+      SELECT 1 FROM dataset_item_media d
+      WHERE d.project_id = m.project_id AND d.media_id = m.id
+    )
+  `;
+  const candidates = await prisma.$queryRaw<
+    Prisma.MediaGetPayload<{ select: { id: true } }>[]
+  >`
+    SELECT m.id FROM media m WHERE ${expiredAndUnassociated}
+    ORDER BY m.updated_at, m.id LIMIT 10
+  `;
+
+  let deleted = 0;
+  for (const candidate of candidates) {
+    try {
+      deleted += await prisma.$transaction(
+        async (tx) => {
+          await lockMediaRecords(tx, projectId, [candidate.id]);
+
+          // Recheck after taking the same lock as reference creation.
+          const eligible = await tx.$queryRaw<
+            Prisma.MediaGetPayload<{
+              select: { id: true; bucketPath: true; bucketName: true };
+            }>[]
+          >`
+          SELECT m.id, m.bucket_path AS "bucketPath", m.bucket_name AS "bucketName"
+          FROM media m WHERE m.id = ${candidate.id} AND ${expiredAndUnassociated}
+        `;
+          const media = eligible[0];
+          if (!media) return 0;
+
+          await getMediaStorageServiceClient(media.bucketName).deleteFiles([
+            media.bucketPath,
+          ]);
+          await tx.media.delete({
+            where: { projectId_id: { projectId, id: media.id } },
+          });
+          return 1;
+        },
+        { timeout: 120_000 },
+      );
+    } catch (error) {
+      if (!(error instanceof LangfuseNotFoundError)) throw error;
+      // Another cleanup request already removed this candidate.
+    }
+  }
+
+  return { deleted, hasMore: candidates.length === 10 };
+}
