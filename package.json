{
  "name": "home-agent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.2"
    }
  },
  "scripts": {
    "setup": "bun scripts/setup-local.ts",
    "dev": "bun scripts/services.ts dev",
    "build": "turbo run build",
    "start": "bun run build && bun --env-file=.env scripts/web-entry.ts production && turbo run start --filter=@home-agent/backend --filter=@home-agent/agent-host",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:root:fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check-types": "turbo run check-types check-types:root",
    "check": "bun run format:check && bun run lint && bun run check-types",
    "test": "turbo run test",
    "db:init": "bun scripts/services.ts initialize",
    "db:migrate": "bun scripts/services.ts migrate",
    "stop": "bun scripts/services.ts stop",
    "status": "bun scripts/services.ts status",
    "lint:root": "oxlint --type-aware --max-warnings 0 scripts oxlint.config.ts",
    "lint:root:fix": "oxlint --type-aware --max-warnings 0 --fix scripts oxlint.config.ts",
    "check-types:root": "tsc --project scripts/tsconfig.json",
    "web:trust": "bun scripts/web-entry.ts trust"
  },
  "devDependencies": {
    "@home-agent/oxlint-config": "workspace:*",
    "@home-agent/typescript-config": "workspace:*",
    "@hono/cli": "^0.2.0-next.9",
    "@langfuse/cli": "1.3.1",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "postgres": "4.1.1",
      "@types/bun": "1.4.4",
      "eslint-plugin-turbo": "2.11.11",
      "hono": "4.13.18",
      "oxfmt": "0.78.0",
      "oxlint": "1.93.0",
      "oxlint-tsgolint": "7.0.2006",
      "turbo": "2.11.11",
      "typescript": "7.0.2",
      "zod": "4.6.7",
      "vite": "8.3.8",
      "@vitejs/plugin-react": "6.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@hono/otel": "1.3.0",
      "@opentelemetry/api": "1.10.0",
      "@opentelemetry/resources": "3.1.1",
      "@opentelemetry/sdk-trace": "3.1.1",
      "@opentelemetry/exporter-trace-otlp-proto": "0.301.1",
      "@opentelemetry/otlp-exporter-base": "0.301.1",
      "@opentelemetry/otlp-transformer": "0.301.1",
      "drizzle-orm": "0.45.4",
      "drizzle-kit": "0.31.11",
      "yaml": "2.9.1",
      "write-file-atomic": "8.0.0",
      "@types/write-file-atomic": "4.0.3",
      "@earendil-works/pi-ai": "1.5.2",
      "@earendil-works/pi-durable": "1.5.2",
      "@earendil-works/chord": "1.5.2",
      "@opentelemetry/sdk-node": "0.301.1",
      "typebox": "1.4.6"
    }
  },
  "patchedDependencies": {
    "piscina@5.3.2": "patches/piscina@5.3.2.patch",
    "@earendil-works/pi-ai@1.5.2": "patches/@earendil-works%2Fpi-ai@1.5.2.patch"
  }
}
